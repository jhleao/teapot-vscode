{
  "name": "teapot-vscode",
  "displayName": "Teapot",
  "description": "Stacked branches visualizer with drag-and-drop rebase intents, native inside VSCode",
  "version": "0.0.10",
  "publisher": "jhleao",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:teapot.stackView",
    "onCommand:teapot.refresh"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "teapot",
          "title": "Teapot",
          "icon": "resources/teapot.svg"
        }
      ]
    },
    "views": {
      "teapot": [
        {
          "type": "webview",
          "id": "teapot.stackView",
          "name": "Teapot",
          "contextualTitle": "Teapot",
          "retainContextWhenHidden": true
        }
      ]
    },
    "commands": [
      {
        "command": "teapot.refresh",
        "title": "Teapot: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "teapot.createWorkingCommit",
        "title": "New Working Commit",
        "category": "Teapot",
        "icon": "$(add)"
      },
      {
        "command": "teapot.pullTrunk",
        "title": "Pull Main from Remote",
        "category": "Teapot",
        "icon": "$(cloud-download)"
      },
      {
        "command": "teapot.branchAndCommit",
        "title": "Teapot: Branch and Commit",
        "icon": "$(git-branch)"
      },
      {
        "command": "teapot.amendAndRebase",
        "title": "Teapot: Amend and Rebase Stack",
        "icon": "$(replace-all)"
      },
      {
        "command": "teapot.copyBranchName",
        "title": "Copy Branch Name",
        "category": "Teapot"
      },
      {
        "command": "teapot.checkoutBranch",
        "title": "Checkout Branch",
        "category": "Teapot"
      },
      {
        "command": "teapot.renameBranch",
        "title": "Rename Branch...",
        "category": "Teapot"
      },
      {
        "command": "teapot.deleteBranch",
        "title": "Delete Branch...",
        "category": "Teapot"
      },
      {
        "command": "teapot.amendCommitMessage",
        "title": "Amend Commit Message...",
        "category": "Teapot"
      },
      {
        "command": "teapot.inspectCommit",
        "title": "Inspect Commit",
        "category": "Teapot"
      },
      {
        "command": "teapot.copyCommitSha",
        "title": "Copy SHA",
        "category": "Teapot"
      },
      {
        "command": "teapot.openWorktreeInNewWindow",
        "title": "Open Worktree in New Window",
        "category": "Teapot"
      },
      {
        "command": "teapot.deleteWorktree",
        "title": "Delete Worktree...",
        "category": "Teapot"
      },
      {
        "command": "teapot.createWorktree",
        "title": "New Worktree Here",
        "category": "Teapot"
      },
      {
        "command": "teapot.rebaseWithTrunk",
        "title": "Rebase with Trunk",
        "category": "Teapot"
      },
      {
        "command": "teapot.squashWithParent",
        "title": "Squash with Parent...",
        "category": "Teapot"
      },
      {
        "command": "teapot.createPullRequest",
        "title": "Create Pull Request...",
        "category": "Teapot"
      },
      {
        "command": "teapot.signInToGitHub",
        "title": "Sign in to GitHub",
        "category": "Teapot"
      },
      {
        "command": "teapot.gitHubStatus",
        "title": "GitHub: Signed In",
        "category": "Teapot",
        "icon": "$(github-inverted)"
      },
      {
        "command": "teapot.gitHubStatusUnauthenticated",
        "title": "GitHub: Sign In Required",
        "category": "Teapot",
        "icon": "$(warning)"
      },
      {
        "command": "teapot.gitHubStatusLoading",
        "title": "GitHub: Loading…",
        "category": "Teapot",
        "icon": "$(sync~spin)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "teapot.branchAndCommit",
          "group": "navigation@1",
          "when": "scmProvider == git"
        },
        {
          "command": "teapot.amendAndRebase",
          "group": "navigation@2",
          "when": "scmProvider == git"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "teapot.branchAndCommit",
          "group": "navigation@1",
          "when": "scmProvider == git"
        },
        {
          "command": "teapot.amendAndRebase",
          "group": "navigation@2",
          "when": "scmProvider == git"
        }
      ],
      "view/title": [
        {
          "command": "teapot.pullTrunk",
          "when": "view == teapot.stackView",
          "group": "navigation@0"
        },
        {
          "command": "teapot.createWorkingCommit",
          "when": "view == teapot.stackView",
          "group": "navigation@1"
        },
        {
          "command": "teapot.gitHubStatus",
          "when": "view == teapot.stackView && teapot.gitHubSessionValid && !teapot.gitHubLoading",
          "group": "navigation@2"
        },
        {
          "command": "teapot.gitHubStatusUnauthenticated",
          "when": "view == teapot.stackView && !teapot.gitHubSessionValid && !teapot.gitHubLoading",
          "group": "navigation@2"
        },
        {
          "command": "teapot.gitHubStatusLoading",
          "when": "view == teapot.stackView && teapot.gitHubLoading",
          "group": "navigation@2"
        },
        {
          "command": "teapot.refresh",
          "when": "view == teapot.stackView",
          "group": "navigation@3"
        }
      ],
      "webview/context": [
        {
          "command": "teapot.createPullRequest",
          "when": "webviewId == 'teapot.stackView' && webviewSection == 'branch-badge' && teapot.gitHubSessionValid && teapotBranchCanCreatePullRequest",
          "group": "0_pr@1"
        },
        {
          "command": "teapot.createWorktree",
          "when": "webviewId == 'teapot.stackView' && webviewSection == 'branch-badge' && !teapotBranchIsCurrent && !teapotBranchHasWorktree",
          "group": "1_worktree@1"
        },
        {
          "command": "teapot.rebaseWithTrunk",
          "when": "webviewId == 'teapot.stackView' && webviewSection == 'branch-badge' && teapotBranchCanRebaseWithTrunk",
          "group": "2_rebase@1"
        },
        {
          "command": "teapot.squashWithParent",
          "when": "webviewId == 'teapot.stackView' && webviewSection == 'branch-badge' && teapotBranchCanSquashWithParent",
          "group": "2_rebase@2"
        },
        {
          "command": "teapot.renameBranch",
          "when": "webviewId == 'teapot.stackView' && webviewSection == 'branch-badge'",
          "group": "9_modification@1"
        },
        {
          "command": "teapot.deleteBranch",
          "when": "webviewId == 'teapot.stackView' && webviewSection == 'branch-badge' && !teapotBranchProtected",
          "group": "9_modification@2"
        },
        {
          "command": "teapot.amendCommitMessage",
          "when": "webviewId == 'teapot.stackView' && webviewSection == 'commit-row' && teapotCommitIsHead",
          "group": "0_commit@1"
        },
        {
          "command": "teapot.inspectCommit",
          "when": "webviewId == 'teapot.stackView' && webviewSection == 'commit-row'",
          "group": "0_commit@2"
        },
        {
          "command": "teapot.copyCommitSha",
          "when": "webviewId == 'teapot.stackView' && webviewSection == 'commit-row'",
          "group": "0_commit@3"
        },
        {
          "command": "teapot.copyBranchName",
          "when": "webviewId == 'teapot.stackView' && webviewSection == 'branch-badge'",
          "group": "9_modification@3"
        },
        {
          "command": "teapot.openWorktreeInNewWindow",
          "when": "webviewId == 'teapot.stackView' && webviewSection == 'worktree-badge'",
          "group": "1_navigation@1"
        },
        {
          "command": "teapot.deleteWorktree",
          "when": "webviewId == 'teapot.stackView' && webviewSection == 'worktree-badge'",
          "group": "2_modification@1"
        }
      ],
      "commandPalette": [
        {
          "command": "teapot.copyBranchName",
          "when": "false"
        },
        {
          "command": "teapot.checkoutBranch",
          "when": "false"
        },
        {
          "command": "teapot.renameBranch",
          "when": "false"
        },
        {
          "command": "teapot.deleteBranch",
          "when": "false"
        },
        {
          "command": "teapot.amendCommitMessage",
          "when": "false"
        },
        {
          "command": "teapot.inspectCommit",
          "when": "false"
        },
        {
          "command": "teapot.copyCommitSha",
          "when": "false"
        },
        {
          "command": "teapot.openWorktreeInNewWindow",
          "when": "false"
        },
        {
          "command": "teapot.deleteWorktree",
          "when": "false"
        },
        {
          "command": "teapot.createWorktree",
          "when": "false"
        },
        {
          "command": "teapot.rebaseWithTrunk",
          "when": "false"
        },
        {
          "command": "teapot.squashWithParent",
          "when": "false"
        },
        {
          "command": "teapot.createPullRequest",
          "when": "false"
        },
        {
          "command": "teapot.gitHubStatus",
          "when": "false"
        },
        {
          "command": "teapot.gitHubStatusUnauthenticated",
          "when": "false"
        },
        {
          "command": "teapot.gitHubStatusLoading",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run typecheck && npm run build",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.4"
  }
}
